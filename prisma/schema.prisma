generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS
  PROVIDER
  ADMIN
}

enum ProviderVerificationState {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  SUBMITTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  DECLINED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role
  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?
  status        String    @default("active") // active | suspended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business?
  provider Provider?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model Business {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String?
  tradeLicenceNumber  String?
  industry            String?
  size                String?
  country             String?
  city                String?
  address             String?
  logoUrl             String?
  website             String?
  contactPerson       String?
  phone               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  serviceRequests ServiceRequest[]
}

model Provider {
  id                     String                     @id @default(cuid())
  userId                 String                     @unique
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String?                    @unique
  companyName            String?
  tradeLicenceNumber     String?
  tradeLicenceExpiry     DateTime?
  categoryId             String?
  category               Category?                  @relation(fields: [categoryId], references: [id])
  description            String?
  city                   String?
  address                String?
  logoUrl                String?
  website                String?
  yearEstablished        Int?
  teamSize               String?
  contactPerson          String?
  phone                  String?
  verificationState      ProviderVerificationState  @default(DRAFT)
  verificationNote       String?
  approvedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  serviceRequests ServiceRequest[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  providers   Provider[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id             String         @id @default(cuid())
  reference      String         @unique // human-readable, e.g. REQ-2026-0001
  title          String
  description    String
  budget         Float?
  requiredByDate DateTime?
  status         RequestStatus  @default(SUBMITTED)
  declineReason  String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents StatusEvent[]
  attachments  Attachment[]

  @@index([businessId])
  @@index([providerId])
  @@index([status])
}

// Audit trail / timeline entry — one row per status change, written
// automatically alongside every ServiceRequest.status update.
model StatusEvent {
  id               String          @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fromStatus       RequestStatus?
  toStatus         RequestStatus
  actor            String // e.g. "Business — Acme Trading Co.", "Provider — Gulf Tech", "Admin"
  note             String?
  createdAt        DateTime        @default(now())

  @@index([serviceRequestId])
}

// File metadata only — actual upload/storage is a separate task, per scope.
model Attachment {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileType         String?
  fileSize         Int?
  uploadedBy       String
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

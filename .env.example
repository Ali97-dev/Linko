# Postgres connection string (Neon, Supabase, or any Postgres host)
DATABASE_URL="postgresql://user:password@host:5432/linko?sslmode=require"

# Long random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Resend API key for transactional email. Leave blank during local dev —
# the app will log verification/reset links to the console instead of sending mail.
RESEND_API_KEY=""
EMAIL_FROM="LINKO <noreply@yourdomain.com>"

# Base URL used to build links inside emails
APP_URL="http://localhost:3000"
